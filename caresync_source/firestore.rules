rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isConnectedCaregiver(patientId) {
      return request.auth != null &&
        (
          (
            exists(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + patientId)) &&
            get(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + patientId)).data.status == 'active'
          ) ||
          (
            exists(/databases/$(database)/documents/connections/$(patientId + '_' + request.auth.uid)) &&
            get(/databases/$(database)/documents/connections/$(patientId + '_' + request.auth.uid)).data.status == 'active'
          )
        );
    }

    match /users/{userId} {
      // Patient has full read/write to own account. Connected caregiver has strictly READ-ONLY access.
      allow read: if request.auth != null && (request.auth.uid == userId || isConnectedCaregiver(userId));
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /{document=**} {
        allow read: if request.auth != null && (request.auth.uid == userId || isConnectedCaregiver(userId));
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /connections/{connectionId} {
      // Read: allowed for either participant
      allow read: if request.auth != null &&
        (resource == null || resource.data.caregiverUid == request.auth.uid || resource.data.patientUid == request.auth.uid || resource.data.senderUid == request.auth.uid);
      
      // Create: caregiver can create a pending connection request
      allow create: if request.auth != null &&
        (request.resource.data.caregiverUid == request.auth.uid || request.resource.data.senderUid == request.auth.uid);
      
      // Update: patient can accept/reject (change status); caregiver can only cancel/disconnect
      allow update: if request.auth != null &&
        (
          (resource.data.patientUid == request.auth.uid) ||
          (resource.data.caregiverUid == request.auth.uid && request.resource.data.status != 'active')
        );

      // Delete: either caregiver or patient can remove / disconnect
      allow delete: if request.auth != null &&
        (resource.data.caregiverUid == request.auth.uid || resource.data.patientUid == request.auth.uid || resource.data.senderUid == request.auth.uid);
    }
  }
}


